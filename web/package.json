{
  "name": "affinityqa-review",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test:recovery": "node ../tests/browser/session-recovery.cjs && node ../tests/browser/session-recovery.cjs --mobile --repeat-interruption",
    "test:case-journey": "node ../tests/browser/new-case-journey.cjs",
    "test:repeatable-journey": "node ../tests/browser/repeatable-case-journey.cjs",
    "test:repeatable-backend": "node ../tests/browser/repeatable-backend-journey.cjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  }
}
